    "import pandas as pd\n",
    "df = pd.DataFrame({\n",
    "    \"Name\": [\"Aman\", \"Sara\", \"Rahul\"],\n",
    "    \"Marks\": [78, 35, 62]\n",
    "})\n",
    "df[\"Result\"] = df[\"Marks\"].apply(\n",
    "    lambda marks: \"Pass\" if marks >= 40 else \"Fail\"\n",
    ")\n",
    "print(df)"
   ]
